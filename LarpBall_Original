int lerOpcao(int minimo, int maximo) {
    int opcao;
    while (scanf("%d", &opcao) != 1 || opcao < minimo || opcao > maximo) {
        printf("Opcao invalida. Digite um numero entre %d e %d: ", minimo, maximo);
        limparEntrada();
    }
    limparEntrada();
    return opcao;
}

