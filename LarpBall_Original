    int opcao;

    do {
        printf("\n=============== PRE-JOGO ===============\n");
        printf("%s x %s\n", nomesSelecoes[selecaoEscolhida],
               nomesSelecoes[selecaoAdversaria]);
        printf("Sua tatica: %s\n", nomesTaticas[taticaAtual]);
        mostrarAdversario();
        printf("[1] Confirmar e iniciar partida\n");
        printf("[2] Alterar sua tatica\n");
        printf("[3] Cancelar e voltar ao menu\n> ");
        opcao = lerOpcao(1, 3);

        if (opcao == 2) {
            escolherTatica();
        } else if (opcao == 1) {
            jogarPartida(selecaoEscolhida);
        }
    } while (opcao == 2);
}

