        tecnico[strcspn(tecnico, "\n")] = '\0';
        if (tecnico[0] == '\0') {
            snprintf(tecnico, sizeof tecnico, "Tecnico");
        }
    }
    selecaoEscolhida = escolherSelecao();
    selecaoAdversaria = sortearAdversario(selecaoEscolhida);
