    for (int i = 0; i < 5; i++) {
        printf("[%d] %s (Energia %d | Habilidade %d | Defesa %d)\n",
               i + 1, nomesSelecoes[i], matrizAtributos[i][0],
               matrizAtributos[i][1], matrizAtributos[i][2]);
    }
    printf("> ");
    opcao = lerOpcao(1, 5);
    printf("Voce escolheu %s!\n", nomesSelecoes[opcao - 1]);
    return opcao - 1;
}

int sortearAdversario(int selecaoEscolhida) {
    int adversario;

    do {
        adversario = rand() % 5;
    } while (adversario == selecaoEscolhida);

    return adversario;
}

