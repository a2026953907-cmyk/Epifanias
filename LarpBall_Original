void inicializarElenco(int selecaoEscolhida) {
    int i;
    for (i = 0; i < 16; i++) {
        snprintf(nomesJogadores[i], sizeof nomesJogadores[i], "%s",
                 elencos[selecaoEscolhida][i]);
        energiaJogador[i] = matrizAtributos[selecaoEscolhida][0] - (i % 3) * 3;
        habilidadeJogador[i] = matrizAtributos[selecaoEscolhida][1] - (i % 4) * 2;
        velocidadeJogador[i] = 72 + selecaoEscolhida * 3 - (i % 4) * 2 + (i % 3) * 3;
        forcaJogador[i] = 76 + selecaoEscolhida * 2 - (i % 5) * 2 + (i % 2) * 3;
        titular[i] = i < 11;
        expulso[i] = 0;
    }
}

void substituirJogador(int obrigatoria) {
    int indiceTitular = -1;
    int indiceReserva = -1;
    int i;
    for (i = 0; i < 16; i++) {
        if (titular[i] && !expulso[i] && indiceTitular == -1) {
            indiceTitular = i;
        }
        if (!titular[i] && !expulso[i] && indiceReserva == -1) {
            indiceReserva = i;
        }
    }
    if (indiceTitular == -1 || indiceReserva == -1) {
        printf("Nao ha jogadores disponiveis para substituicao.\n");
        return;
    }
    if (!obrigatoria) {
        printf("Deseja substituir %s? [1] Sim [2] Nao: ", nomesJogadores[indiceTitular]);
        if (lerOpcao(1, 2) == 2) {
            energiaJogador[indiceTitular] -= 10;
            printf("%s continua em campo, mas fica cansado.\n", nomesJogadores[indiceTitular]);
            return;
        }
    }
    titular[indiceTitular] = 0;
    titular[indiceReserva] = 1;
    energiaJogador[indiceReserva] = 85;
    substituicoes++;
    printf("Substituicao: %s entra no lugar de %s.\n",
           nomesJogadores[indiceReserva], nomesJogadores[indiceTitular]);
}

void ataque(int selecaoEscolhida) {
    int jogada;
    int bonus = bonusAtaque();
    int desgaste = desgasteTatica();
    printf("Sua selecao recupera a bola! Escolha a jogada:\n");
    printf("[1] Tocar a bola (risco baixo)\n");
    printf("[2] Cruzamento na area (risco medio)\n");
    printf("[3] Chute de longe (risco alto)\n> ");
    jogada = lerOpcao(1, 3);
    ataques++;
    if (jogada == 1) {
        entrosamento += 2;
        energiaJogador[1] -= desgaste;
        registrarDecisao("Tocou a bola e manteve a posse");
        printf("A equipe troca passes e mantem a posse.\n");
    } else if (jogada == 2) {
        entrosamento++;
        energiaJogador[3] -= 3 + desgaste;
        registrarDecisao("Tentou cruzamento na area");
        if (rand() % 100 < 28 + matrizAtributos[selecaoEscolhida][1] / 20 + bonus) {
            golsMarcados++;
            printf("GOOOOOOOL! Cruzamento perfeito!\n");
        } else {
            printf("O cruzamento passa por todo mundo.\n");
        }
    } else {
        entrosamento--;
        energiaJogador[4] -= 5 + desgaste;
        registrarDecisao("Arriscou chute de longe");
        if (rand() % 100 < 18 + matrizAtributos[selecaoEscolhida][1] / 10 + bonus) {
            golsMarcados++;
            printf("GOOOOOOOL! Um foguete de longe!\n");
        } else {
            printf("O chute sai forte, mas gera contra-ataque.\n");
            if (rand() % 100 < 25 - bonus / 2) {
                golsSofridos++;
                printf("Contra-ataque perigoso: gol do adversario!\n");
            }
        }
    }
}

void defesa(int selecaoEscolhida) {
    int opcao;
    int bonus = bonusDefesa();
    printf("O adversario avancou. Escolha a marcacao:\n");
    printf("[1] Marcacao individual (cansa mais)\n");
    printf("[2] Marcacao por zona (preserva energia)\n> ");
    opcao = lerOpcao(1, 2);
    defesas++;
    if (opcao == 1) {
        energiaJogador[2] -= 6 + desgasteTatica();
        registrarDecisao("Usou marcacao individual");
        if (rand() % 100 < matrizAtributos[selecaoEscolhida][2] + bonus) {
            printf("A marcacao individual bloqueia o chute!\n");
        } else {
            golsSofridos++;
            printf("O adversario consegue marcar.\n");
        }
    } else {
        energiaJogador[2] -= 2 + desgasteTatica() / 2;
        registrarDecisao("Usou marcacao por zona");
        if (rand() % 100 < matrizAtributos[selecaoEscolhida][2] - 18 + bonus) {
            printf("A linha defensiva fecha os espacos.\n");
        } else {
            golsSofridos++;
            printf("O adversario encontra espaco e marca.\n");
        }
    }
}

void critico(int tipo) {
    if (tipo == 0) {
        printf("Jogador cansado detectado: %s (Energia: %d)\n",
               nomesJogadores[3], energiaJogador[3]);
        substituirJogador(0);
        registrarDecisao("Reagiu a jogador cansado");
    } else if (tipo == 1) {
        int cobrador;
        printf("Falta perigosa! Quem cobra?\n");
        printf("[1] %s [2] %s [3] %s\n> ",
               nomesJogadores[4], nomesJogadores[5], nomesJogadores[6]);
        cobrador = lerOpcao(1, 3);
        registrarDecisao("Escolheu cobrador de falta");
        if (rand() % 100 < 20 + habilidadeJogador[3 + cobrador] / 8) {
            golsMarcados++;
            entrosamento += 3;
            printf("GOOOOOOOL DE FALTA!\n");
        } else {
            printf("A bola passa perto, mas nao entra.\n");
        }
    } else if (tipo == 2) {
        cartoes++;
        printf("CARTAO AMARELO!\n");
        registrarDecisao("Recebeu cartao amarelo");
        if (rand() % 100 < 20) {
            printf("Segundo amarelo! Jogador expulso.\n");
            expulso[2] = 1;
            titular[2] = 0;
        }
    } else {
        printf("LESAO! Substituicao obrigatoria para %s.\n", nomesJogadores[3]);
        energiaJogador[3] = 0;
        entrosamento -= 3;
        substituirJogador(1);
        registrarDecisao("Substituiu jogador lesionado");
    }
}

void verificarVAR(void) {
    if (golsMarcados > 0 && rand() % 100 < 25) {
        printf("VAR analisando... GOL ANULADO!\n");
        golsMarcados--;
        golsAnulados++;
    } else {
        printf("VAR analisando... Gol confirmado!\n");
    }
}

void zerarEstatisticas(void) {
    golsMarcados = 0;
    golsSofridos = 0;
    entrosamento = 70;
    substituicoes = 0;
    ataques = 0;
    defesas = 0;
    cartoes = 0;
    golsAnulados = 0;
    totalDecisoes = 0;
}

void jogarPartida(int selecaoEscolhida) {
    int minuto = 0;
    int ultimoGol = 0;
    zerarEstatisticas();
    printf("\n--- INICIO DA PARTIDA: %s x %s ---\n",
           nomesSelecoes[selecaoEscolhida], nomesSelecoes[selecaoAdversaria]);
    printf("Tatica escolhida: %s\n", nomesTaticas[taticaAtual]);
    do {
        int evento;
        minuto += 5;
        printf("\n%d' - Placar: %s %d x %d %s | Entrosamento: %d\n",
               minuto, nomesSelecoes[selecaoEscolhida], golsMarcados,
               golsSofridos, nomesSelecoes[selecaoAdversaria], entrosamento);
        evento = rand() % 100;
        if (evento < 35) {
            ataque(selecaoEscolhida);
        } else if (evento < 70) {
            defesa(selecaoEscolhida);
        } else if (evento < 80) {
            critico(0);
        } else if (evento < 85) {
            critico(1);
        } else if (evento < 90) {
            critico(2);
        } else if (evento < 93) {
            critico(3);
        } else if (evento < 95) {
            golsSofridos++;
            entrosamento -= 5;
            printf("FRANGO DO GOLEIRO! Gol do adversario!\n");
        } else {
            printf("O VAR e acionado.\n");
            if (golsMarcados > ultimoGol) {
                verificarVAR();
            } else {
                printf("Nao havia gol recente para revisar.\n");
            }
        }
        if (golsMarcados > ultimoGol) {
            ultimoGol = golsMarcados;
            if (rand() % 100 < 30) {
                verificarVAR();
                ultimoGol = golsMarcados;
            }
        }
        if (entrosamento < 0) {
            entrosamento = 0;
        }
    } while (minuto < 90);

    printf("\n========== FIM DE JOGO ==========\n");
    printf("Placar Final: %s %d x %d %s\n", nomesSelecoes[selecaoEscolhida],
           golsMarcados, golsSofridos, nomesSelecoes[selecaoAdversaria]);
    printf("Ataques: %d | Defesas: %d | Substituicoes: %d | Cartoes: %d\n",
           ataques, defesas, substituicoes, cartoes);
    printf("Gols anulados pelo VAR: %d\n", golsAnulados);
    printf("Entrosamento final: %d\n", entrosamento);
    printf("Resumo das decisoes:\n");
    for (int i = 0; i < totalDecisoes; i++) {
        printf("- %s\n", decisoes[i]);
    }
    if (golsMarcados > golsSofridos) {
        printf("VITORIA! O trabalho do tecnico foi decisivo!\n");
    } else if (golsMarcados == golsSofridos) {
        printf("EMPATE! Uma partida equilibrada.\n");
    } else {
        printf("DERROTA. A equipe lutou ate o ultimo minuto.\n");
    }
}

int escolherSelecao(void) {
    int opcao;
