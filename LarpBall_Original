        printf("\n=========== MENU PRINCIPAL ===========\n");
        printf("Tecnico: %s | Selecao: %s\n", tecnico, nomesSelecoes[selecaoEscolhida]);
        printf("Tatica atual: %s\n", nomesTaticas[taticaAtual]);
        printf("Proximo adversario: %s | Tatica: %s\n",
               nomesSelecoes[selecaoAdversaria],
               nomesTaticas[taticasAdversarias[selecaoAdversaria]]);
        printf("[1] Ver pre-jogo e iniciar partida\n[2] Ver elenco e taticas\n[3] Alterar tatica\n");
        printf("[4] Ver adversario\n[5] Ver tutorial\n[6] Sair\n> ");
        opcao = lerOpcao(1, 6);
        if (opcao == 1) {
            prepararPartida(selecaoEscolhida);
        } else if (opcao == 2) {
            mostrarElenco(selecaoEscolhida);
        } else if (opcao == 3) {
            escolherTatica();
        } else if (opcao == 4) {
            mostrarAdversario();
        } else if (opcao == 5) {
            mostrarTutorial();
        } else {
            printf("Ate a proxima, tecnico %s!\n", tecnico);
        }
    } while (opcao != 6);
    return 0;
}
