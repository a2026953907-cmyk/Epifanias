int bonusAtaque(void) {
    if (taticaAtual == 0) {
        return 12;
    }
    if (taticaAtual == 1) {
        return -10;
    }
    if (taticaAtual == 3) {
        return 8;
    }
    if (taticaAtual == 4) {
        return 10;
    }
    return 0;
}

int bonusDefesa(void) {
    if (taticaAtual == 0) {
        return -15;
    }
    if (taticaAtual == 1) {
        return 15;
    }
    if (taticaAtual == 3) {
        return 8;
    }
    if (taticaAtual == 4) {
        return 5;
    }
    return 0;
}

int desgasteTatica(void) {
    if (taticaAtual == 0) {
        return 2;
    }
    if (taticaAtual == 1) {
        return 0;
    }
    if (taticaAtual == 3) {
        return 3;
    }
    return 1;
}

